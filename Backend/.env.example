# Port number
PORT=3000

# Fastify log level
LOG_LEVEL=debug

#JWT random string
JWT_TOKEN_SECERT=scert_key

#JWT expiry
JWT_TOKEN_EXPIRY='your_expiry'

#Player Time expiryDuration in ms
PLAYER_DETAILS_DELETE_TIME=3600000

FRONTEND_URL=""
ML_SERVICE_URL=""

# Free-tier TURN (recommended for college WiFi / restrictive NATs)
# Option 1: Cloudflare Realtime TURN (1,000 GB/month free, includes port 443 TLS)
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# Option 2: Metered.ca TURN (20 GB/month free, includes port 443 TLS)
METERED_APP_NAME=""
METERED_API_KEY=""

# Option 3: Static TURN / self-hosted coturn (comma-separated URLs)
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""